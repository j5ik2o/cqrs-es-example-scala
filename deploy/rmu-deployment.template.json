{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "RMU Lambda, head-stream event source mapping, OnFailure SQS, SQS recovery worker, and scheduled resync worker for cqrs-es-example-scala. The Lambda code artifact is supplied as parameters; this repository builds it but does not deploy it.",
  "Metadata": {
    "Project": "cqrs-es-example-scala",
    "Issue": "https://github.com/j5ik2o/cqrs-es-example-scala/issues/11"
  },
  "Parameters": {
    "CodeS3Bucket": {
      "Type": "String",
      "Description": "S3 bucket that holds the Lambda deployment package."
    },
    "CodeS3Key": {
      "Type": "String",
      "Description": "S3 key of the Lambda deployment package. It must contain the three handlers and their dependencies."
    },
    "HeadStreamArn": {
      "Type": "String",
      "Description": "ARN of the head table's DynamoDB stream."
    },
    "HeadTableName": {
      "Type": "String",
      "Default": "cqrs-es-example-head"
    },
    "JournalTableName": {
      "Type": "String",
      "Default": "cqrs-es-example-journal"
    },
    "SnapshotTableName": {
      "Type": "String",
      "Default": "cqrs-es-example-snapshot"
    },
    "SnapshotIndexName": {
      "Type": "String",
      "Default": "snapshot-active-history-index"
    },
    "ReadModelDatabaseUrl": {
      "Type": "String",
      "NoEcho": true,
      "Description": "JDBC URL of the MySQL read model, for example jdbc:mysql://db.example:3306/ceer."
    },
    "ReadModelDatabaseUser": {
      "Type": "String",
      "NoEcho": true
    },
    "ReadModelDatabasePassword": {
      "Type": "String",
      "NoEcho": true
    },
    "VpcId": {
      "Type": "String",
      "Default": "",
      "Description": "VPC of the MySQL instance. Leave empty when the database is reachable without a VPC attachment."
    },
    "SubnetIds": {
      "Type": "CommaDelimitedList",
      "Default": "",
      "Description": "Subnets of the Lambda functions. Required when VpcId is set."
    },
    "SecurityGroupIds": {
      "Type": "CommaDelimitedList",
      "Default": "",
      "Description": "Security groups of the Lambda functions. Required when VpcId is set."
    },
    "RmuTimeoutSeconds": {
      "Type": "Number",
      "Default": 300,
      "MinValue": 31,
      "MaxValue": 900,
      "Description": "RMU function timeout. It must exceed the retry elapsed budget (30000 ms) plus database work."
    },
    "RecoveryWorkerTimeoutSeconds": {
      "Type": "Number",
      "Default": 300,
      "MinValue": 30,
      "MaxValue": 900
    },
    "ResyncWorkerTimeoutSeconds": {
      "Type": "Number",
      "Default": 900,
      "MinValue": 30,
      "MaxValue": 900,
      "Description": "The resync worker scans every head, so it gets the Lambda maximum by default."
    },
    "RmuBatchSize": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 1,
      "MaxValue": 10000
    },
    "MaximumRetryAttempts": {
      "Type": "Number",
      "Default": 3,
      "MinValue": 0,
      "MaxValue": 10000,
      "Description": "Lambda retries before a failed stream record goes to the OnFailure queue."
    },
    "MaximumRecordAgeInSeconds": {
      "Type": "Number",
      "Default": 604800,
      "MinValue": 60,
      "MaxValue": 604800
    },
    "RetryMaxAttempts": {
      "Type": "Number",
      "Default": 5,
      "MinValue": 1
    },
    "RetryMaxElapsedMillis": {
      "Type": "Number",
      "Default": 30000,
      "MinValue": 0
    },
    "RetryInitialDelayMillis": {
      "Type": "Number",
      "Default": 200,
      "MinValue": 0
    },
    "RetryMaxDelayMillis": {
      "Type": "Number",
      "Default": 5000,
      "MinValue": 0
    },
    "RecoveryMaxTasksPerRun": {
      "Type": "Number",
      "Default": 50,
      "MinValue": 1
    },
    "RecoveryQueueVisibilityTimeoutSeconds": {
      "Type": "Number",
      "Default": 1800,
      "MinValue": 30,
      "MaxValue": 43200,
      "Description": "Must stay at or above RecoveryWorkerTimeoutSeconds. Six times the function timeout is the AWS recommendation."
    },
    "OnFailureMaxReceiveCount": {
      "Type": "Number",
      "Default": 5,
      "MinValue": 1
    },
    "RecoveryMaxReceiveCount": {
      "Type": "Number",
      "Default": 5,
      "MinValue": 1
    },
    "RecoveryScheduleExpression": {
      "Type": "String",
      "Default": "rate(5 minutes)",
      "Description": "EventBridge schedule for the recovery worker. It drains pending tasks even when no SQS notification arrives."
    },
    "ResyncScheduleExpression": {
      "Type": "String",
      "Default": "rate(1 day)",
      "Description": "EventBridge schedule for the full head resync."
    }
  },
  "Conditions": {
    "UsesVpc": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "VpcId"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "OnFailureDlq": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-rmu-on-failure-dlq"
        },
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 60
      }
    },
    "OnFailureQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-rmu-on-failure"
        },
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 60,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "OnFailureDlq",
              "Arn"
            ]
          },
          "maxReceiveCount": {
            "Ref": "OnFailureMaxReceiveCount"
          }
        }
      }
    },
    "RecoveryDlq": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-rmu-recovery-dlq"
        },
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 60
      }
    },
    "RecoveryQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-rmu-recovery"
        },
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": {
          "Ref": "RecoveryQueueVisibilityTimeoutSeconds"
        },
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "RecoveryDlq",
              "Arn"
            ]
          },
          "maxReceiveCount": {
            "Ref": "RecoveryMaxReceiveCount"
          }
        }
      }
    },
    "RmuFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "rmu-stream-tables-and-queues",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadHeadStream",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:DescribeStream",
                    "dynamodb:GetRecords",
                    "dynamodb:GetShardIterator",
                    "dynamodb:ListStreams"
                  ],
                  "Resource": {
                    "Ref": "HeadStreamArn"
                  }
                },
                {
                  "Sid": "ReadHeadAndJournalTables",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${HeadTableName}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${JournalTableName}"
                    }
                  ]
                },
                {
                  "Sid": "SendRecoveryAndFailureMessages",
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "RecoveryQueue",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "OnFailureQueue",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "RecoveryWorkerFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "rmu-recovery-worker-tables-and-queue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadHeadAndJournalTables",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${HeadTableName}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${JournalTableName}"
                    }
                  ]
                },
                {
                  "Sid": "ConsumeRecoveryQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes",
                    "sqs:ChangeMessageVisibility"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RecoveryQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ResyncWorkerFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "rmu-resync-worker-tables-and-queue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadHeadAndJournalTables",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${HeadTableName}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${JournalTableName}"
                    }
                  ]
                },
                {
                  "Sid": "SendRecoveryMessages",
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "RecoveryQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RmuFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-rmu"
        },
        "Runtime": "java17",
        "Handler": "com.github.j5ik2o.cqrs.es.example.scala.lambda.LambdaReadModelUpdater::handleRequest",
        "Code": {
          "S3Bucket": {
            "Ref": "CodeS3Bucket"
          },
          "S3Key": {
            "Ref": "CodeS3Key"
          }
        },
        "Timeout": {
          "Ref": "RmuTimeoutSeconds"
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": [
            "RmuFunctionRole",
            "Arn"
          ]
        },
        "VpcConfig": {
          "Fn::If": [
            "UsesVpc",
            {
              "SubnetIds": {
                "Ref": "SubnetIds"
              },
              "SecurityGroupIds": {
                "Ref": "SecurityGroupIds"
              }
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "HEAD_TABLE_NAME": {
              "Ref": "HeadTableName"
            },
            "JOURNAL_TABLE_NAME": {
              "Ref": "JournalTableName"
            },
            "SNAPSHOT_TABLE_NAME": {
              "Ref": "SnapshotTableName"
            },
            "SNAPSHOT_ACTIVE_HISTORY_INDEX_NAME": {
              "Ref": "SnapshotIndexName"
            },
            "STREAM_RETRY_MAX_ATTEMPTS": {
              "Fn::Sub": "${RetryMaxAttempts}"
            },
            "STREAM_RETRY_MAX_ELAPSED_MILLIS": {
              "Fn::Sub": "${RetryMaxElapsedMillis}"
            },
            "STREAM_RETRY_INITIAL_DELAY_MILLIS": {
              "Fn::Sub": "${RetryInitialDelayMillis}"
            },
            "STREAM_RETRY_MAX_DELAY_MILLIS": {
              "Fn::Sub": "${RetryMaxDelayMillis}"
            },
            "STREAM_RECOVERY_MAX_TASKS_PER_RUN": {
              "Fn::Sub": "${RecoveryMaxTasksPerRun}"
            },
            "RECOVERY_QUEUE_URL": {
              "Ref": "RecoveryQueue"
            },
            "READ_MODEL_DATABASE_URL": {
              "Ref": "ReadModelDatabaseUrl"
            },
            "READ_MODEL_DATABASE_USER": {
              "Ref": "ReadModelDatabaseUser"
            },
            "READ_MODEL_DATABASE_PASSWORD": {
              "Ref": "ReadModelDatabasePassword"
            }
          }
        }
      }
    },
    "RmuEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "RmuFunction"
        },
        "EventSourceArn": {
          "Ref": "HeadStreamArn"
        },
        "StartingPosition": "TRIM_HORIZON",
        "BatchSize": {
          "Ref": "RmuBatchSize"
        },
        "MaximumBatchingWindowInSeconds": 1,
        "BisectBatchOnFunctionError": true,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "MaximumRetryAttempts": {
          "Ref": "MaximumRetryAttempts"
        },
        "MaximumRecordAgeInSeconds": {
          "Ref": "MaximumRecordAgeInSeconds"
        },
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "OnFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "RecoveryWorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-rmu-recovery-worker"
        },
        "Runtime": "java17",
        "Handler": "com.github.j5ik2o.cqrs.es.example.scala.lambda.LambdaRecoveryWorker::handleRequest",
        "Code": {
          "S3Bucket": {
            "Ref": "CodeS3Bucket"
          },
          "S3Key": {
            "Ref": "CodeS3Key"
          }
        },
        "Timeout": {
          "Ref": "RecoveryWorkerTimeoutSeconds"
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": [
            "RecoveryWorkerFunctionRole",
            "Arn"
          ]
        },
        "VpcConfig": {
          "Fn::If": [
            "UsesVpc",
            {
              "SubnetIds": {
                "Ref": "SubnetIds"
              },
              "SecurityGroupIds": {
                "Ref": "SecurityGroupIds"
              }
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "HEAD_TABLE_NAME": {
              "Ref": "HeadTableName"
            },
            "JOURNAL_TABLE_NAME": {
              "Ref": "JournalTableName"
            },
            "SNAPSHOT_TABLE_NAME": {
              "Ref": "SnapshotTableName"
            },
            "SNAPSHOT_ACTIVE_HISTORY_INDEX_NAME": {
              "Ref": "SnapshotIndexName"
            },
            "STREAM_RECOVERY_MAX_TASKS_PER_RUN": {
              "Fn::Sub": "${RecoveryMaxTasksPerRun}"
            },
            "READ_MODEL_DATABASE_URL": {
              "Ref": "ReadModelDatabaseUrl"
            },
            "READ_MODEL_DATABASE_USER": {
              "Ref": "ReadModelDatabaseUser"
            },
            "READ_MODEL_DATABASE_PASSWORD": {
              "Ref": "ReadModelDatabasePassword"
            }
          }
        }
      }
    },
    "RecoveryWorkerEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "RecoveryWorkerFunction"
        },
        "EventSourceArn": {
          "Fn::GetAtt": [
            "RecoveryQueue",
            "Arn"
          ]
        },
        "BatchSize": 1,
        "MaximumBatchingWindowInSeconds": 0,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ]
      }
    },
    "RecoveryWorkerSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-rmu-recovery-schedule"
        },
        "Description": "Drains pending recovery tasks even when no SQS notification arrives.",
        "ScheduleExpression": {
          "Ref": "RecoveryScheduleExpression"
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "RecoveryWorkerFunction",
                "Arn"
              ]
            },
            "Id": "recovery-worker"
          }
        ]
      }
    },
    "RecoveryWorkerSchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "RecoveryWorkerFunction"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "RecoveryWorkerSchedule",
            "Arn"
          ]
        }
      }
    },
    "ResyncWorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-rmu-resync-worker"
        },
        "Runtime": "java17",
        "Handler": "com.github.j5ik2o.cqrs.es.example.scala.lambda.LambdaResyncWorker::handleRequest",
        "Code": {
          "S3Bucket": {
            "Ref": "CodeS3Bucket"
          },
          "S3Key": {
            "Ref": "CodeS3Key"
          }
        },
        "Timeout": {
          "Ref": "ResyncWorkerTimeoutSeconds"
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": [
            "ResyncWorkerFunctionRole",
            "Arn"
          ]
        },
        "VpcConfig": {
          "Fn::If": [
            "UsesVpc",
            {
              "SubnetIds": {
                "Ref": "SubnetIds"
              },
              "SecurityGroupIds": {
                "Ref": "SecurityGroupIds"
              }
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "HEAD_TABLE_NAME": {
              "Ref": "HeadTableName"
            },
            "JOURNAL_TABLE_NAME": {
              "Ref": "JournalTableName"
            },
            "SNAPSHOT_TABLE_NAME": {
              "Ref": "SnapshotTableName"
            },
            "SNAPSHOT_ACTIVE_HISTORY_INDEX_NAME": {
              "Ref": "SnapshotIndexName"
            },
            "STREAM_RECOVERY_MAX_TASKS_PER_RUN": {
              "Fn::Sub": "${RecoveryMaxTasksPerRun}"
            },
            "RECOVERY_QUEUE_URL": {
              "Ref": "RecoveryQueue"
            },
            "READ_MODEL_DATABASE_URL": {
              "Ref": "ReadModelDatabaseUrl"
            },
            "READ_MODEL_DATABASE_USER": {
              "Ref": "ReadModelDatabaseUser"
            },
            "READ_MODEL_DATABASE_PASSWORD": {
              "Ref": "ReadModelDatabasePassword"
            }
          }
        }
      }
    },
    "ResyncWorkerSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-rmu-resync-schedule"
        },
        "Description": "Rebuilds the read model lag from the journal when the stream mapping was unavailable.",
        "ScheduleExpression": {
          "Ref": "ResyncScheduleExpression"
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "ResyncWorkerFunction",
                "Arn"
              ]
            },
            "Id": "resync-worker"
          }
        ]
      }
    },
    "ResyncWorkerSchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ResyncWorkerFunction"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "ResyncWorkerSchedule",
            "Arn"
          ]
        }
      }
    }
  },
  "Outputs": {
    "RmuFunctionName": {
      "Value": {
        "Ref": "RmuFunction"
      }
    },
    "RmuFunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "RmuFunction",
          "Arn"
        ]
      }
    },
    "RmuEventSourceMappingId": {
      "Value": {
        "Ref": "RmuEventSourceMapping"
      }
    },
    "OnFailureQueueArn": {
      "Value": {
        "Fn::GetAtt": [
          "OnFailureQueue",
          "Arn"
        ]
      }
    },
    "OnFailureQueueUrl": {
      "Value": {
        "Ref": "OnFailureQueue"
      }
    },
    "RecoveryQueueArn": {
      "Value": {
        "Fn::GetAtt": [
          "RecoveryQueue",
          "Arn"
        ]
      }
    },
    "RecoveryQueueUrl": {
      "Value": {
        "Ref": "RecoveryQueue"
      }
    },
    "RecoveryWorkerFunctionName": {
      "Value": {
        "Ref": "RecoveryWorkerFunction"
      }
    },
    "ResyncWorkerFunctionName": {
      "Value": {
        "Ref": "ResyncWorkerFunction"
      }
    }
  }
}
